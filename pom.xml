<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Project identity -->
    <groupId>631b36cf-166a-4a20-9380-d502faee3fe0</groupId>
    <artifactId>aflora-premium-sys-api-v1</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>mule-application</packaging>

    <name>aflora-premium-sys-api-v1</name>

    <!-- Project properties -->
    <properties>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Mule runtime -->
        <app.runtime>4.12.1</app.runtime>

        <!-- Mule Maven Plugin -->
        <mule.maven.plugin.version>4.10.1</mule.maven.plugin.version>

        <!-- CloudHub 2.0 deployment -->
        <environment>dev</environment>
        <targetName>Cloudhub-US-East-2</targetName>
        <appName>aflora-premium-sys-api-v1-dev</appName>
		
		<connectedAppGrantType>client_credentials</connectedAppGrantType>
    </properties>

    <!-- Build configuration -->
    <build>

        <plugins>

            <!-- Maven Clean Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>

            <!-- Mule Maven Plugin -->
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>

                <configuration>

                    <!-- Publish Mule application to Exchange -->
                    <classifier>mule-application</classifier>

                    <!-- CloudHub 2.0 deployment -->
                    <cloudhub2Deployment>

                        <uri>https://anypoint.mulesoft.com</uri>

                        <provider>MC</provider>

                        <environment>${environment}</environment>

                        <target>${targetName}</target>

                        <muleVersion>${app.runtime}</muleVersion>

                        <applicationName>${appName}</applicationName>
                        <businessGroupId>631b36cf-166a-4a20-9380-d502faee3fe0</businessGroupId>
                        <replicas>1</replicas>

                        <vCores>0.1</vCores>
                        <!-- Connected App authentication -->
					    <connectedAppClientId>${connectedAppClientId}</connectedAppClientId>
					    <connectedAppClientSecret>${connectedAppClientSecret}</connectedAppClientSecret>
					    <connectedAppGrantType>${connectedAppGrantType}</connectedAppGrantType>

                    </cloudhub2Deployment>

                </configuration>

            </plugin>

        </plugins>

    </build>

    <!-- Mule dependencies -->
    <dependencies>

        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>1.11.3</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-sockets-connector</artifactId>
            <version>1.2.7</version>
            <classifier>mule-plugin</classifier>
        </dependency>

    </dependencies>

    <!-- Dependency repositories -->
    <repositories>

        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
            <layout>default</layout>
        </repository>

        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/nexus/repository/releases/</url>
            <layout>default</layout>
        </repository>

    </repositories>

    <!-- Maven plugin repositories -->
    <pluginRepositories>

        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <layout>default</layout>

            <url>
                https://repository.mulesoft.org/nexus/repository/releases/
            </url>

            <snapshots>
                <enabled>false</enabled>
            </snapshots>

        </pluginRepository>

    </pluginRepositories>

    <!-- Where Maven publishes the application -->
    <distributionManagement>
	    <repository>
	        <id>anypoint-exchange-v3</id>
	        <name>Anypoint Exchange</name>
	        <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/631b36cf-166a-4a20-9380-d502faee3fe0/maven</url>
	        <layout>default</layout>
	    </repository>
	</distributionManagement>

</project>